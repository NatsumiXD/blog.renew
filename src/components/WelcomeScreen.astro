---
import { brandHeading, logo } from "./rhine-lab/brand";
import { BOOT_BRAND } from "./rhine-lab/config";
import { url } from "../utils/url-utils";
import "../styles/rhine-welcome.css";
---

<rhine-welcome hidden role="dialog" aria-modal="true" aria-label={`${BOOT_BRAND} 启动画面`} data-pagefind-ignore>
  <div class="rhine-stage" data-layout="opening" data-mode="boot" aria-hidden="true">
    <div id="boot-background" class="boot-background">
      <svg viewBox="0 0 1920 1080" preserveAspectRatio="none"><g fill="none" stroke="#fff" stroke-width="3"><path d="M-210 705C-45 705 182 704 247 567C337 377 99 306 4 435S27 680 169 631C309 584 227 314 279 111S568-113 568-113"/><path d="M1560-80C1374 114 1671 168 1601 323S1371 367 1431 480S1692 666 1559 787S1329 886 1498 1130"/><circle cx="1450" cy="648" r="346"/><circle cx="1450" cy="648" r="348"/></g></svg>
      <div class="boot-white"></div>
    </div>
    <header class="brand" set:html={brandHeading}></header>
    <section class="boot">
      <div class="access-text">ACCESS</div>
      <div class="boot-logo" set:html={logo}></div>
      <div class="auth-status"><span>▪</span> <span id="auth-message"></span><i></i></div>
      <div class="scan">
        <svg viewBox="0 0 1920 1080"><g fill="none" stroke="#080a08" stroke-width="2" stroke-linecap="round"><path/><path stroke="#fff"/><path/><path/><path/><path/><circle class="orbit-dot" r="8" fill="#ed821b" stroke="none"/><circle class="orbit-dot" r="8" fill="#ed821b" stroke="none"/><circle class="scan-core" cx="960" cy="540" r="5" fill="#080a08" stroke="none"/></g></svg>
        <span>PERMISSION AUTHORIZED</span>
      </div>
      <div class="welcome">
        <div class="welcome-panel"></div>
        <div class="welcome-heading">WELCOME TO</div>
        <div class="welcome-company"><strong>{BOOT_BRAND}</strong><strong class="welcome-highlight">{BOOT_BRAND}</strong></div>
        <div class="welcome-database">INTERNAL DATABASE</div>
        <div class="welcome-logo" set:html={logo}></div>
      </div>
    </section>
    <div class="powered">POWERED BY <b>{BOOT_BRAND}</b><i></i></div>
  </div>
  <div class="rhine-entry">
    <div class="rhine-entry-mark" aria-hidden="true" set:html={logo}></div>
    <p class="rhine-entry-label">ANALYSIS OS / INTERNAL DATABASE</p>
    <button type="button" class="rhine-start" disabled>正在准备终端…</button>
    <p class="rhine-entry-note">连接完成后将自动进入博客首页</p>
  </div>
  <p class="rhine-status sr-only" role="status" aria-live="polite"></p>
  <a class="rhine-skip" href={url("/")} data-astro-reload>跳过动画，进入博客 <span aria-hidden="true">↗</span></a>
</rhine-welcome>

<script is:inline>
  (() => {
    const screen = document.querySelector('rhine-welcome');
    if (!screen) return;
    let entered = false;
    try { entered = sessionStorage.getItem('rhine-welcome-entered') === '1'; } catch {}
    if (entered) { screen.remove(); return; }
    screen.hidden = false;
    document.documentElement.classList.add('welcome-pending');
    document.getElementById('blog-surface')?.setAttribute('inert', '');
    // The homepage remains usable even if the animation module fails to load.
    screen.querySelector('.rhine-skip')?.addEventListener('click', event => {
      event.preventDefault();
      screen.dispatchEvent(new Event('rhine:skip'));
      try { sessionStorage.setItem('rhine-welcome-entered', '1'); } catch {}
      document.documentElement.classList.remove('welcome-pending');
      const surface = document.getElementById('blog-surface');
      surface?.removeAttribute('inert');
      screen.remove();
      const main = surface?.querySelector('main');
      main?.setAttribute('tabindex', '-1');
      main?.focus({ preventScroll: true });
    });
  })();
</script>
<noscript><style>rhine-welcome { display: none !important; }</style></noscript>
<script>
  import "./rhine-lab/welcome";
</script>
